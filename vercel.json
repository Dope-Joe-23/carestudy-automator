{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "cd artifacts/carestudy-assistant && pnpm install && pnpm build",
  "outputDirectory": "artifacts/carestudy-assistant/dist/public",
  "installCommand": "corepack enable && pnpm install --frozen-lockfile",
  "rewrites": [
    {
      "source": "/((?!assets/|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
