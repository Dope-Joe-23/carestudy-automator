# ============================================================================
# Frontend Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# ============================================================================

# Backend API URL — where the Express API server is deployed.
# In local dev, the Vite proxy forwards /api to localhost:5000.
# In production, set this to your Render deployment URL.
# Example: https://carestudy-api.onrender.com/api
VITE_API_URL=/api

# Paystack public key for student payments (Mobile Money, bank transfer).
# Get yours at https://dashboard.paystack.com -> Settings -> API Keys
# Example: pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_PAYSTACK_PUBLIC_KEY=
