# Copy this file to .env and fill in your values.
# The API server auto-loads .env at startup; values already set in the
# process environment (e.g. via setx or $env:) take precedence.

# Storage backend for study history: "sqlite" (default, local file) or
# "postgres" (when deployed). The API is identical either way.
# DB_DRIVER=postgres

# SQLite database file (default backend). Defaults to <repo root>/carestudy.db;
# tables are created automatically on first use, so no setup is required.
SQLITE_PATH=

# Postgres connection string — only required when DB_DRIVER=postgres.
# Create the tables with: pnpm --filter @workspace/db run push:pg
# DATABASE_URL=postgresql://user:password@host/dbname

# Anthropic API key (used directly when ANTHROPIC_AUTH_TOKEN is not set)
ANTHROPIC_API_KEY=

# OpenRouter (or other Anthropic-compatible gateway) bearer token
ANTHROPIC_AUTH_TOKEN=

# API endpoint override — OpenRouter: https://openrouter.ai/api
ANTHROPIC_BASE_URL=https://openrouter.ai/api

# Model override — e.g. openai/gpt-oss-20b:free, google/gemma-4-31b-it:free, openrouter/free
ANTHROPIC_MODEL=openai/gpt-oss-20b:free

# Optional comma-separated model fallback list. For OpenRouter deployments,
# openrouter/free is retried automatically when this value is unset.
# ANTHROPIC_FALLBACK_MODELS=your-provider/your-paid-model

# Studio admin account — the only people who can open the studio / order bin.
# The first login creates the account from these values (only when no admin
# exists yet, so rotating them later never clobbers a changed password).
# ADMIN_PASSWORD is required to bootstrap; leave blank to keep the studio
# locked with no usable admin.
#
# This account gets role="admin" by default, which grants access to:
# - The studio (drafting, exports, order bin)
# - The admin dashboard (/studio/dashboard) — hidden, only accessible via URL
# - Staff management and invite link generation
#
# Staff accounts (role="staff") can only access the studio and order bin.
# They cannot access the dashboard or manage other staff.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional display name for the admin (shown in the studio).
# ADMIN_NAME=Academic Team

# Maximum size (in MB) for base64-in-JSON file uploads — the transport used
# when R2 is not configured. Defaults to 250 MB so large ebooks work out of
# the box in development; lower it on memory-constrained deployments.
# MAX_UPLOAD_MB=250

# Paystack secret key for payment verification (Mobile Money, bank transfer).
# Get yours at https://dashboard.paystack.com -> Settings -> API Keys
# If unset, payments fall back to dev-mode auto-verification.
# PAYSTACK_SECRET_KEY=sk_live_<your-key-here>

# NurseFlow teaching visuals.
#
# The default provider is Cloudflare Workers AI (flux-1-schnell): a still image
# the learner page animates with CSS, standing in for the silent 8s clip the
# pipeline used to render. Needs a Cloudflare API token with Workers AI
# permission plus your account id. The free allocation is ~40 images per day
# (resets 00:00 UTC); beyond that it is roughly $0.003 per image.
# Create a token: Cloudflare dashboard -> My Profile -> API Tokens.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# Optional overrides for the Cloudflare provider.
# NURSEFLOW_CF_ACCOUNT_ID=   (wins over CLOUDFLARE_ACCOUNT_ID)
# NURSEFLOW_CF_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_AI_BASE_URL=https://api.cloudflare.com/client/v4
#
# Legacy Pollinations provider (NURSEFLOW_VISUAL_PROVIDER=image). Its free
# anonymous generation was retired: every request now routes to a paid
# "Gen Sana" pipeline that fails on an empty pollen balance. A token no longer
# makes it free — it only authenticates your account's balance.
# NURSEFLOW_IMAGE_TOKEN=
# Image model and requested size. Pollinations snaps to a model bucket, so the
# delivered pixels can differ while the 9:16 ratio holds.
# NURSEFLOW_IMAGE_MODEL=flux
# NURSEFLOW_IMAGE_WIDTH=720
# NURSEFLOW_IMAGE_HEIGHT=1280
# Pin a seed for reproducible art; leave unset so "Generate again" varies.
# NURSEFLOW_IMAGE_SEED=
# Optional gateway override.
# NURSEFLOW_IMAGE_BASE_URL=https://image.pollinations.ai
#
# Provider selection. Default: cloudflare. Set to "image" for the legacy
# Pollinations provider, or "veo" for real video (below).
# NURSEFLOW_VISUAL_PROVIDER=cloudflare
#
# Opt in to real video instead: Google's Veo models on the Gemini API
# (x-goog-api-key). Needs a Google AI project with Veo access and billing -
# Google's pricing table lists no free tier for Veo. This key is used only by
# the API server; never expose it as a VITE_ variable.
# NURSEFLOW_VISUAL_PROVIDER=veo
# GEMINI_API_KEY=
# Model override. Defaults to veo-3.1-generate-preview; the Gemini API also
# serves veo-3.1-lite-generate-preview and the GA veo-3.1-generate-001.
# NURSEFLOW_VIDEO_MODEL=veo-3.1-generate-preview
# Optional gateway or regional endpoint override.
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Visual job records and the cached assets (JPEGs by default, MP4s under Veo).

# Point both at a mounted persistent volume in production, or the visuals are
# lost on redeploy.
# NURSEFLOW_VIDEO_PATH=/persistent/nurseflow/video-jobs.json
# NURSEFLOW_VIDEO_DIR=/persistent/nurseflow/videos

# NurseFlow's anonymous trial and paid-access records. Point both NurseFlow
# paths at a mounted persistent volume in production.
# NURSEFLOW_CONTENT_PATH=/persistent/nurseflow/question-bank.json
# NURSEFLOW_ACCESS_PATH=/persistent/nurseflow/access.json
# Read-only example batch the Studio's "Load starter questions" button pulls
# into the import editor. Defaults to <repo root>/data/nurseflow/starter-questions.json.
# NURSEFLOW_STARTER_PATH=/persistent/nurseflow/starter-questions.json
# NurseFlow Plus monthly price in Ghana cedis. Paystack receives pesewas.
# NURSEFLOW_MONTHLY_PRICE_GHS=35

# Cloudflare R2 object storage — durable storage for uploaded documents
# (study files + personal-library ebooks/articles).
#
# When all four values are set, uploads go straight from the browser to the
# bucket via presigned URLs, so files are never buffered by the server at
# all (same 250 MB ceiling as the base64 fallback). The raw file stays in
# the bucket; the server only downloads it briefly to extract text for the
# retrieval index.
# Leave these blank to keep using local disk (base64 uploads, size capped by
# MAX_UPLOAD_MB above).
#
# Create a bucket + API token in the R2 dashboard, then enable CORS on the
# bucket so the browser PUTs are allowed (allowed methods PUT + HEAD, allowed
# header Content-Type, your app's origin or "*").
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
