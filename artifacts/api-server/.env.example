# Copy this file to .env and fill in your values.
# The API server auto-loads .env at startup; values already set in the
# process environment (e.g. via setx or $env:) take precedence.

# Storage backend for study history: "sqlite" (default, local file) or
# "postgres" (when deployed). The API is identical either way.
# DB_DRIVER=postgres

# SQLite database file (default backend). Defaults to <repo root>/carestudy.db;
# tables are created automatically on first use, so no setup is required.
SQLITE_PATH=

# Postgres connection string — only required when DB_DRIVER=postgres.
# Create the tables with: pnpm --filter @workspace/db run push:pg
# DATABASE_URL=postgresql://user:password@host/dbname

# Anthropic API key (used directly when ANTHROPIC_AUTH_TOKEN is not set)
ANTHROPIC_API_KEY=

# OpenRouter (or other Anthropic-compatible gateway) bearer token
ANTHROPIC_AUTH_TOKEN=

# API endpoint override — OpenRouter: https://openrouter.ai/api
ANTHROPIC_BASE_URL=https://openrouter.ai/api

# Model override — e.g. openai/gpt-oss-20b:free, google/gemma-4-31b-it:free, openrouter/free
ANTHROPIC_MODEL=openai/gpt-oss-20b:free

# Optional comma-separated model fallback list. For OpenRouter deployments,
# openrouter/free is retried automatically when this value is unset.
# ANTHROPIC_FALLBACK_MODELS=your-provider/your-paid-model

# Studio admin account — the only people who can open the studio / order bin.
# The first login creates the account from these values (only when no admin
# exists yet, so rotating them later never clobbers a changed password).
# ADMIN_PASSWORD is required to bootstrap; leave blank to keep the studio
# locked with no usable admin.
#
# This account gets role="admin" by default, which grants access to:
# - The studio (drafting, exports, order bin)
# - The admin dashboard (/studio/dashboard) — hidden, only accessible via URL
# - Staff management and invite link generation
#
# Staff accounts (role="staff") can only access the studio and order bin.
# They cannot access the dashboard or manage other staff.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Optional display name for the admin (shown in the studio).
# ADMIN_NAME=Academic Team

# Maximum size (in MB) for base64-in-JSON file uploads — the transport used
# when R2 is not configured. Defaults to 250 MB so large ebooks work out of
# the box in development; lower it on memory-constrained deployments.
# MAX_UPLOAD_MB=250

# Paystack secret key for payment verification (Mobile Money, bank transfer).
# Get yours at https://dashboard.paystack.com -> Settings -> API Keys
# If unset, payments fall back to dev-mode auto-verification.
# PAYSTACK_SECRET_KEY=sk_live_<your-key-here>

# Cloudflare R2 object storage — durable storage for uploaded documents
# (study files + personal-library ebooks/articles).
#
# When all four values are set, uploads go straight from the browser to the
# bucket via presigned URLs, so files are never buffered by the server at
# all (same 250 MB ceiling as the base64 fallback). The raw file stays in
# the bucket; the server only downloads it briefly to extract text for the
# retrieval index.
# Leave these blank to keep using local disk (base64 uploads, size capped by
# MAX_UPLOAD_MB above).
#
# Create a bucket + API token in the R2 dashboard, then enable CORS on the
# bucket so the browser PUTs are allowed (allowed methods PUT + HEAD, allowed
# header Content-Type, your app's origin or "*").
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
