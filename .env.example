# ============================================================================
# Root Environment Variables (for docker-compose)
# ============================================================================
# Copy this file to .env and fill in your values.
# These values are used by docker-compose.yml.
# ============================================================================

# ── API Keys ──
# Required: Your OpenRouter or Anthropic API token for the AI drafting engine
ANTHROPIC_AUTH_TOKEN=

# Optional: API endpoint override (default: https://openrouter.ai/api)
# ANTHROPIC_BASE_URL=https://openrouter.ai/api

# Optional: Model override (default: openai/gpt-oss-20b:free)
# ANTHROPIC_MODEL=openai/gpt-oss-20b:free

# ── Admin Credentials ──
# Required: The admin password for the studio interface
ADMIN_PASSWORD=changeme

# ── Cloudflare R2 (Optional) ──
# Set these to enable direct-to-bucket file uploads (no size limit)
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
